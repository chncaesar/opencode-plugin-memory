{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@chncaesar/opencode-plugin-memory",
  "version": "0.8.0",
  "description": "PR-gated persistent memory plugin for OpenCode — a global store shared by every repository plus a per-repository store; the LLM proposes, a bot opens a PR, a human merges, the index is derived from active memories",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "ai-memory",
    "agent-memory",
    "llm-memory",
    "persistent-memory",
    "project-memory",
    "context-engineering",
    "agents-md",
    "ai-coding-agent",
    "human-in-the-loop",
    "typescript"
  ],
  "homepage": "https://github.com/chncaesar/opencode-plugin-memory#readme",
  "bugs": {
    "url": "https://github.com/chncaesar/opencode-plugin-memory/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chncaesar/opencode-plugin-memory.git"
  },
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "bin": {
    "opencode-memory-bot": "./dist/bot.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsc && node --test dist/*.test.js"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.23",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
