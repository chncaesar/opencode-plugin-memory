{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@chncaesar/opencode-plugin-memory",
  "version": "0.2.1",
  "description": "PR-gated, project-scoped persistent memory plugin for OpenCode — the LLM proposes, a bot opens a PR, a human merges, CI regenerates the index",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "bin": {
    "opencode-memory-bot": "./dist/bot.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsc && node --test dist/*.test.js"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.23",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
